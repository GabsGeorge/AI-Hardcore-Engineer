          <mxGeometry x="700" y="440" width="170" height="60" as="geometry" />
        </mxCell>

        <mxCell id="b_kn_t" value="&lt;b&gt;allowlist Knowledge&lt;/b&gt;&lt;br&gt;hybrid_retrieve (BM25 bm25s + densa → RRF → rerank)&lt;br&gt;web_search (DuckDuckGo, cache)&lt;br&gt;&lt;i&gt;contexto = dado não confiável&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
