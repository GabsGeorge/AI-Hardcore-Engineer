        <mxCell id="b_note1" value="&lt;b&gt;Identidade fora do LLM:&lt;/b&gt; user_id vem de config[&quot;configurable&quot;], preenchido pela API a partir do JWT. Não está no estado visível ao LLM nem no schema das tools." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
