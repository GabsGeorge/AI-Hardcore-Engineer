# Copie para .env e preencha. Nunca versione o .env (constitution II).

# --- Ambiente ---
APP_ENV=local

# --- OpenAI (GPT) ---
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=
OPENAI_MODEL_FALLBACK=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Autenticação (JWT HS256; gere com: openssl rand -hex 32) ---
JWT_SECRET=
JWT_ISSUER=getnet-support
JWT_AUDIENCE=getnet-support-api

# --- Infra (o compose monta DATABASE_URL e REDIS_URL a partir destes valores) ---
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=

# --- Orquestração ---
MAX_STEPS=6
TOKEN_BUDGET_PER_RUN=20000
CONFIDENCE_REPLAN=0.70
CONFIDENCE_ESCALATE_HARD=0.40
RAG_RELEVANCE_THRESHOLD=0.30

# --- Limites e handoff ---
RATE_LIMIT_PER_MIN=30
HANDOFF_SLA_MINUTES=15
HANDOFF_EXPIRY_HOURS=24

# --- Retenção (LGPD) ---
RETENTION_CONVERSATION_DAYS=90
RETENTION_LOG_DAYS=30
RETENTION_AUDIT_DAYS=365

# --- Avaliação e observabilidade ---
EVAL_SAMPLE_RATE=0.10
OTEL_EXPORTER_OTLP_ENDPOINT=
# Grafana (profile `obs`). O admin/admin padrão foi removido: gere a senha com
# `./scripts/gen_grafana_password.sh` ou defina manualmente. O compose com `--profile obs`
# recusa a subir se GRAFANA_ADMIN_PASSWORD estiver vazio.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Dados mock (vazio = hoje) ---
SEED_REFERENCE_DATE=

# --- Interface web (feature 002) ---
SESSION_SECRET=
PASSWORD_PEPPER=
# Mailpit roda no compose; aponte para outro SMTP só em produção.
SMTP_URL=smtp://mailpit:1025
WEB_BASE_URL=http://localhost
# Admin de demonstração. Em produção, o primeiro admin é criado por comando.
ADMIN_SEED_EMAIL=admin@getnet.local
# Deixe vazio: scripts/create_demo_admin.py gera e imprime a senha UMA vez.
ADMIN_SEED_PASSWORD=
