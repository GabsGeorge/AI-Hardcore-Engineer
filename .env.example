# Copie para .env e rode: ./scripts/bootstrap_env.sh
# O script preenche todos os segredos aleatorios (JWT_SECRET, POSTGRES_PASSWORD,
# SESSION_SECRET, PASSWORD_PEPPER, ADMIN_SEED_PASSWORD, GRAFANA_ADMIN_PASSWORD).
# Depois disso, basta preencher OPENAI_API_KEY abaixo para `docker compose up -d` subir.
#
# Nunca versione o .env (constitution II).

# --- Ambiente ---
APP_ENV=local

# --- OpenAI (GPT) ---
# UNICA variavel obrigatoria antes do `docker compose up`.
OPENAI_API_KEY=
# Modelos padrao (podem ser trocados sem recompor; o fallback cobre indisponibilidade do primario).
OPENAI_MODEL_PRIMARY=gpt-4o-mini
OPENAI_MODEL_FALLBACK=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Autenticacao (JWT HS256) ---
# bootstrap_env.sh gera com: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=getnet-support
JWT_AUDIENCE=getnet-support-api

# --- Infra (o compose monta DATABASE_URL e REDIS_URL a partir destes valores) ---
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=

# --- Orquestracao ---
MAX_STEPS=6
TOKEN_BUDGET_PER_RUN=20000
CONFIDENCE_REPLAN=0.70
CONFIDENCE_ESCALATE_HARD=0.40
RAG_RELEVANCE_THRESHOLD=0.30

# --- Limites e handoff ---
RATE_LIMIT_PER_MIN=30
HANDOFF_SLA_MINUTES=15
HANDOFF_EXPIRY_HOURS=24

# --- Retencao (LGPD) ---
RETENTION_CONVERSATION_DAYS=90
RETENTION_LOG_DAYS=30
RETENTION_AUDIT_DAYS=365

# --- Avaliacao e observabilidade ---
EVAL_SAMPLE_RATE=0.10
OTEL_EXPORTER_OTLP_ENDPOINT=
# Grafana (profile `obs`). bootstrap_env.sh gera. Sem profile obs, esta variavel pode ficar
# vazia — o compose base nao exige mais este valor para subir (so o service `grafana` o le).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Dados mock (vazio = hoje) ---
SEED_REFERENCE_DATE=

# --- Interface web (feature 002) ---
SESSION_SECRET=
PASSWORD_PEPPER=
# Mailpit roda no compose; aponte para outro SMTP so em producao.
SMTP_URL=smtp://mailpit:1025
WEB_BASE_URL=http://localhost
# Admin de demonstracao. bootstrap_env.sh gera a senha.
ADMIN_SEED_EMAIL=admin@getnet.local
ADMIN_SEED_PASSWORD=
